+
+export type EnhancePreviewChoice = "enhanced" | "original" | "cancel"
+
+/** Opens the review dialog and resolves with what the person chose. */
+export function showPromptEnhancePreview(
+  dialog: ReturnType<typeof useDialog>,
+  original: string,
+  enhanced: string,
+): Promise<EnhancePreviewChoice> {
+  return new Promise((resolve) => {
+    let settled = false
+    const finish = (choice: EnhancePreviewChoice) => {
+      if (settled) return
+      settled = true
+      resolve(choice)
+      dialog.close()
+    }
+
+    void dialog.show(
+      () => <DialogPromptEnhancePreview original={original} enhanced={enhanced} onChoose={finish} />,
+      () => finish("cancel"),
+    )
+  })
+}
+
+function DialogPromptEnhancePreview(props: {
+  original: string
+  enhanced: string
+  onChoose: (choice: EnhancePreviewChoice) => void
+}) {
+  const language = useLanguage()
+  const [pane, setPane] = createSignal<"enhanced" | "original">("enhanced")
+
+  return (
+    <Dialog size="large" fit>
+      <DialogHeader closeLabel={language.t("common.close")}>
+        <DialogTitleGroup
+          title={language.t("ui.promptEnhance.preview.title")}
+          description={language.t("ui.promptEnhance.preview.description")}
+        />
+      </DialogHeader>
+      <DialogBody class="gap-3">
+        <div class="flex items-center gap-1.5">
+          <For each={["enhanced", "original"] as const}>
+            {(value) => (
+              <Button size="small" variant={pane() === value ? "outline" : "ghost"} onClick={() => setPane(value)}>
+                {language.t(
+                  value === "enhanced" ? "ui.promptEnhance.preview.enhanced" : "ui.promptEnhance.preview.original",
+                )}
+              </Button>
+            )}
+          </For>
+        </div>
+        <div class="max-h-[45vh] min-h-24 overflow-auto whitespace-pre-wrap rounded-md border border-v2-border-border-base bg-v2-background-bg-layer-01 p-3 text-[13px] leading-5 text-v2-text-text-base [overflow-wrap:anywhere]">
+          <Show when={pane() === "enhanced"} fallback={props.original}>
+            {props.enhanced}
+          </Show>
+        </div>
+      </DialogBody>
+      <DialogFooter>
+        <Button variant="ghost" onClick={() => props.onChoose("cancel")}>
+          {language.t("common.cancel")}
+        </Button>
+        <Button variant="ghost" onClick={() => props.onChoose("original")}>
+          {language.t("ui.promptEnhance.preview.sendOriginal")}
+        </Button>
+        <Button variant="contrast" onClick={() => props.onChoose("enhanced")}>
+          {language.t("ui.promptEnhance.preview.sendEnhanced")}
+        </Button>
+      </DialogFooter>
+    </Dialog>
+  )
+}
