+import { createSignal } from "solid-js"
+import { isAttachment } from "./prompt-parts"
+import type { Prompt } from "./state"
+
+/** One reusable enhancer configuration: a model, an optional agent, and its instructions. */
+export type PromptEnhancerProfile = {
+  id: string
+  name: string
+  /** An OpenCode agent whose system prompt is added as context. */
+  agent?: string
+  /** Explicit model for enhancement. When absent the composer model is used. */
+  providerID?: string
+  modelID?: string
+  /** How the model should rewrite a prompt. */
+  instructions: string
+}
+
+/**
+ * Settings for the prompt enhancer. They live in the renderer's local storage so they survive
+ * reloads without needing a server config round trip; the enhancer is a client-side convenience,
+ * not a project or session setting.
+ */
+export type PromptEnhancerSettings = {
+  enabled: boolean
+  /** Show the rewritten prompt for review before it is sent. */
+  preview: boolean
+  activeProfileID: string
+  profiles: PromptEnhancerProfile[]
+}
+
+export const DEFAULT_ENHANCER_INSTRUCTIONS = `Rewrite the prompt for a coding assistant so it is clear, specific, and easy to act on.
+
+Return only the rewritten prompt. Do not add a preface, labels, quotes, or a code fence.
+
+Rules:
+- Preserve the author's intent, language, and every concrete requirement.
+- Remove filler, repetition, and vague phrasing. Do not invent requirements, files, or facts.
+- Make the goal, relevant context, constraints, and expected outcome explicit.
+- If the request is ambiguous, state a reasonable assumption briefly instead of asking a question.
+- Keep code, commands, paths, URLs, and @mentions exactly as written.`
+
+const STORAGE_KEY = "opencode.prompt-enhancer.v1"
+
+const DEFAULT_PROFILE_ID = "default"
+
+function defaultProfile(): PromptEnhancerProfile {
+  return { id: DEFAULT_PROFILE_ID, name: "Default", instructions: DEFAULT_ENHANCER_INSTRUCTIONS }
+}
+
+function defaults(): PromptEnhancerSettings {
+  return { enabled: false, preview: true, activeProfileID: DEFAULT_PROFILE_ID, profiles: [defaultProfile()] }
+}
+
+function cloneSettings(value: PromptEnhancerSettings): PromptEnhancerSettings {
+  return { ...value, profiles: value.profiles.map((profile) => ({ ...profile })) }
+}
+
+function profileID(value: unknown, fallback: string) {
+  return typeof value === "string" && value.trim() ? value : fallback
+}
+
+function readProfile(value: unknown, index: number): PromptEnhancerProfile | undefined {
+  if (!value || typeof value !== "object") return
+
+  // SAFETY: the stored value is our own JSON; each field is checked before use so older or
+  // hand-edited values cannot break the composer.
+  const profile = value as Record<string, unknown>
+
+  return {
+    id: profileID(profile.id, `profile-${index + 1}`),
+    name:
+      typeof profile.name === "string" && profile.name.trim()
+        ? profile.name
+        : index === 0
+          ? "Default"
+          : `Profile ${index + 1}`,
+    agent: typeof profile.agent === "string" && profile.agent ? profile.agent : undefined,
+    providerID: typeof profile.providerID === "string" ? profile.providerID : undefined,
+    modelID: typeof profile.modelID === "string" ? profile.modelID : undefined,
+    instructions:
+      typeof profile.instructions === "string" && profile.instructions.trim()
+        ? profile.instructions
+        : DEFAULT_ENHANCER_INSTRUCTIONS,
+  }
+}
+
+function readSettings(): PromptEnhancerSettings {
+  if (typeof localStorage === "undefined") return defaults()
+
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY)
+
+    if (!raw) return defaults()
+
+    // SAFETY: the stored value is our own JSON; every field is validated below.
+    const stored = JSON.parse(raw) as Record<string, unknown>
+
+    const profiles = Array.isArray(stored.profiles)
+      ? stored.profiles.map(readProfile).filter((profile): profile is PromptEnhancerProfile => !!profile)
+      : []
+
+    // v1 stored a single model and instruction set at the top level.
+    if (!profiles.length) {
+      const migrated = readProfile(
+        {
+          id: DEFAULT_PROFILE_ID,
+          name: "Default",
+          providerID: stored.providerID,
+          modelID: stored.modelID,
+          instructions: stored.instructions,
+        },
+        0,
+      )
+
+      if (migrated) profiles.push(migrated)
+    }
+
+    if (!profiles.length) return defaults()
+
+    const seen = new Set<string>()
+    profiles.forEach((profile, index) => {
+      if (seen.has(profile.id)) profile.id = `${profile.id}-${index + 1}`
+      seen.add(profile.id)
+    })
+
+    const active = profiles.find((profile) => profile.id === stored.activeProfileID)
+
+    return {
+      enabled: typeof stored.enabled === "boolean" ? stored.enabled : defaults().enabled,
+      preview: typeof stored.preview === "boolean" ? stored.preview : defaults().preview,
+      activeProfileID: active?.id ?? profiles[0]!.id,
+      profiles,
+    }
+  } catch {
+    return defaults()
+  }
+}
+
+const [settings, setSettings] = createSignal<PromptEnhancerSettings>(readSettings())
+
+function persist(next: PromptEnhancerSettings) {
+  const value = cloneSettings(next)
+  setSettings(value)
+
+  try {
+    if (typeof localStorage !== "undefined") localStorage.setItem(STORAGE_KEY, JSON.stringify(value))
+  } catch {
+    // A failed write only loses the preference on the next launch; the open window keeps it.
+  }
+}
+
+export function promptEnhancerSettings() {
+  return settings()
+}
+
+export function activePromptEnhancerProfile(): PromptEnhancerProfile {
+  const current = settings()
+
+  return (
+    current.profiles.find((profile) => profile.id === current.activeProfileID) ??
+    current.profiles[0] ??
+    defaultProfile()
+  )
+}
+
+export function updatePromptEnhancerSettings(patch: Partial<PromptEnhancerSettings>) {
+  persist({ ...settings(), ...patch })
+}
+
+export function defaultPromptEnhancerSettings(): PromptEnhancerSettings {
+  return cloneSettings(defaults())
+}
+
+const [enhancing, setEnhancing] = createSignal(false)
+
+/** Mirrors whether a rewrite is in flight, so the composer can show progress and refuse a second send. */
+export function promptEnhancing() {
+  return enhancing()
+}
+
+export function setPromptEnhancing(value: boolean) {
+  setEnhancing(value)
+}
+
+/** Slash commands, shell input, and empty drafts are sent as-is. */
+export function isEnhanceableText(text: string) {
+  const trimmed = text.trim()
+
+  return trimmed.length > 0 && !trimmed.startsWith("/")
+}
+
+export function buildEnhancementPrompt(
+  text: string,
+  instructions = DEFAULT_ENHANCER_INSTRUCTIONS,
+  agentContext?: string,
+) {
+  const agent = agentContext?.trim()
+
+  return `${agent ? `${agent}\n\n` : ""}${instructions}
+
+Original prompt:
+"""
+${text}
+"""`
+}
+
+/** Models occasionally wrap a rewrite in a fence or quotes despite the instruction. */
+export function cleanEnhancedText(raw: string) {
+  let text = raw.trim()
+
+  const fenced = text.match(/^```(?:[^\n]*)\n([\s\S]*?)\n?```$/)
+
+  if (fenced) text = (fenced[1] ?? text).trim()
+
+  if (
+    text.length >= 2 &&
+    ((text.startsWith('"') && text.endsWith('"')) || (text.startsWith("'") && text.endsWith("'"))) &&
+    !text.slice(1, -1).includes(text[0])
+  )
+    text = text.slice(1, -1).trim()
+
+  return text
+}
+
+type MentionPart = Exclude<Prompt[number], { type: "text" }>
+
+function isMention(part: Prompt[number]): part is Extract<MentionPart, { content: string }> {
+  return !isAttachment(part) && part.type !== "text"
+}
+
+/**
+ * Rebuilds a prompt around a rewritten body while keeping its attachments and references.
+ * Mentions that disappeared from the rewrite are appended, so a referenced file or skill is
+ * still attached to the sent request.
+ */
+export function rebuildPrompt(prompt: Prompt, enhanced: string): Prompt {
+  let text = enhanced.trim()
+  const mentions = prompt.filter(isMention)
+
+  let cursor = 0
+  const placed = mentions.map((part) => {
+    let start = text.indexOf(part.content, cursor)
+
+    if (start < 0) start = text.indexOf(part.content)
+
+    if (start < 0) {
+      text += `${text.length ? " " : ""}${part.content}`
+      start = text.length - part.content.length
+    }
+
+    cursor = start + part.content.length
+
+    return { part, start }
+  })
+
+  const parts: Prompt = []
+  let position = 0
+
+  for (const { part, start } of placed.toSorted((a, b) => a.start - b.start)) {
+    if (start > position) {
+      parts.push({ type: "text", content: text.slice(position, start), start: position, end: start })
+    }
+
+    parts.push({ ...part, start, end: start + part.content.length })
+    position = start + part.content.length
+  }
+
+  if (position < text.length) {
+    parts.push({ type: "text", content: text.slice(position), start: position, end: text.length })
+  }
+
+  return [...parts, ...prompt.filter(isAttachment)]
+}
