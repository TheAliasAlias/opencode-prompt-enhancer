+import { For, Show, createMemo, createSignal, onCleanup, onMount } from "solid-js"
+import { createStore } from "solid-js/store"
+import { Button } from "@opencode/ui/button"
+import { Checkbox } from "@opencode/ui/checkbox"
+import { Dialog, DialogBody, DialogFooter, DialogHeader, DialogTitleGroup } from "@opencode/ui/dialog"
+import { Icon } from "@opencode/ui/icon"
+import { Select } from "@opencode/ui/select"
+import { Textarea } from "@opencode/ui/textarea"
+import { TextInput } from "@opencode/ui/text-input"
+import { useDialog } from "@opencode/ui/context/dialog"
+import { useModels } from "@/providers/models/models"
+import { useData } from "@/runtime/server/current"
+import { normalizeAgentList } from "@/runtime/server/global-sync/utils"
+import { useLanguage } from "@/runtime/i18n/language"
+import { useWorkspaceLocation } from "@/workspaces/location"
+import {
+  DEFAULT_ENHANCER_INSTRUCTIONS,
+  defaultPromptEnhancerSettings,
+  promptEnhancerSettings,
+  updatePromptEnhancerSettings,
+  type PromptEnhancerProfile,
+  type PromptEnhancerSettings,
+} from "./enhance"
+
+type Option = {
+  id: string
+  label: string
+}
+
+type ModelOption = Option & {
+  providerID?: string
+  modelID?: string
+}
+
+const CURRENT_MODEL: ModelOption = { id: "__current__", label: "" }
+
+const NO_AGENT = ""
+
+function uniqueProfileName(profiles: PromptEnhancerProfile[], base: string) {
+  if (!profiles.some((profile) => profile.name === base)) return base
+
+  let index = 2
+
+  while (profiles.some((profile) => profile.name === `${base} ${index}`)) index += 1
+
+  return `${base} ${index}`
+}
+
+function newProfileID() {
+  return globalThis.crypto?.randomUUID?.() ?? `profile-${Date.now()}`
+}
+
+/** The settings dialog the composer's cog opens. */
+export function DialogPromptEnhanceSettings() {
+  const dialog = useDialog()
+  const language = useLanguage()
+  const models = useModels()
+  const data = useData()
+  const location = useWorkspaceLocation()
+  const [draft, setDraft] = createStore<PromptEnhancerSettings>(structuredClone(promptEnhancerSettings()))
+  const [modelSearch, setModelSearch] = createSignal("")
+  const [modelOpen, setModelOpen] = createSignal(false)
+  let modelPicker: HTMLDivElement | undefined
+
+  onMount(() => {
+    const close = (event: PointerEvent) => {
+      if (!modelOpen()) return
+      if (event.target instanceof Node && modelPicker?.contains(event.target)) return
+
+      setModelOpen(false)
+    }
+
+    document.addEventListener("pointerdown", close)
+    onCleanup(() => document.removeEventListener("pointerdown", close))
+  })
+
+  const profileOptions = createMemo<Option[]>(() =>
+    draft.profiles.map((profile) => ({ id: profile.id, label: profile.name || "Untitled profile" })),
+  )
+
+  const activeProfile = createMemo(
+    () => draft.profiles.find((profile) => profile.id === draft.activeProfileID) ?? draft.profiles[0],
+  )
+
+  const activeIndex = createMemo(() => draft.profiles.findIndex((profile) => profile.id === activeProfile()?.id))
+
+  const editProfile = (patch: Partial<PromptEnhancerProfile>) => {
+    const index = activeIndex()
+
+    if (index < 0) return
+
+    setDraft("profiles", index, (profile) => ({ ...profile, ...patch }))
+  }
+
+  const selectProfile = (option: Option | null) => {
+    if (!option) return
+
+    setDraft("activeProfileID", option.id)
+    setModelSearch("")
+    setModelOpen(false)
+  }
+
+  const addProfile = () => {
+    const profile: PromptEnhancerProfile = {
+      id: newProfileID(),
+      name: uniqueProfileName(draft.profiles, "New profile"),
+      instructions: DEFAULT_ENHANCER_INSTRUCTIONS,
+    }
+
+    setDraft("profiles", draft.profiles.length, profile)
+    setDraft("activeProfileID", profile.id)
+    setModelSearch("")
+    setModelOpen(false)
+  }
+
+  const duplicateProfile = () => {
+    const source = activeProfile()
+
+    if (!source) return
+
+    const copy: PromptEnhancerProfile = {
+      ...source,
+      id: newProfileID(),
+      name: uniqueProfileName(draft.profiles, `${source.name || "Profile"} copy`),
+    }
+
+    setDraft("profiles", draft.profiles.length, copy)
+    setDraft("activeProfileID", copy.id)
+    setModelSearch("")
+    setModelOpen(false)
+  }
+
+  const deleteProfile = () => {
+    if (draft.profiles.length <= 1) return
+    const id = activeProfile()?.id
+    const next = draft.profiles.filter((profile) => profile.id !== id)
+
+    if (!next.length) return
+
+    setDraft("profiles", next)
+    setDraft("activeProfileID", next[0]!.id)
+    setModelSearch("")
+    setModelOpen(false)
+  }
+
+  const agents = createMemo(() =>
+    normalizeAgentList(data.location.agent.list({ directory: location().directory }) ?? []).filter(
+      (agent) => !agent.hidden,
+    ),
+  )
+
+  const agentOptions = createMemo<Option[]>(() => [
+    { id: NO_AGENT, label: language.t("ui.promptEnhance.agent.none") },
+    ...agents().map((agent) => ({ id: agent.name, label: agent.name })),
+  ])
+
+  const currentAgent = createMemo(
+    () => agentOptions().find((option) => option.id === (activeProfile()?.agent ?? NO_AGENT)) ?? agentOptions()[0],
+  )
+
+  const selectAgent = (option: Option | null) => {
+    editProfile({ agent: option?.id || undefined })
+  }
+
+  const modelOptions = createMemo<ModelOption[]>(() => [
+    { ...CURRENT_MODEL, label: language.t("ui.promptEnhance.model.current") },
+    ...models.list().map((model) => ({
+      id: `${model.provider.id}:${model.id}`,
+      providerID: model.provider.id,
+      modelID: model.id,
+      label: `${model.provider.name} · ${model.name}`,
+    })),
+  ])
+
+  const selectedModelID = createMemo(() => {
+    const profile = activeProfile()
+
+    return profile?.providerID && profile.modelID ? `${profile.providerID}:${profile.modelID}` : CURRENT_MODEL.id
+  })
+
+  const selectedModelLabel = createMemo(() => {
+    const profile = activeProfile()
+
+    if (!profile?.providerID || !profile.modelID) return language.t("ui.promptEnhance.model.current")
+
+    const option = modelOptions().find(
+      (item) => item.providerID === profile.providerID && item.modelID === profile.modelID,
+    )
+
+    return option?.label ?? `${profile.providerID} · ${profile.modelID}`
+  })
+
+  const filteredModels = createMemo(() => {
+    const query = modelSearch().trim().toLowerCase()
+
+    if (!query) return modelOptions()
+
+    return modelOptions().filter((option) => `${option.label} ${option.id}`.toLowerCase().includes(query))
+  })
+
+  const selectModel = (option: ModelOption) => {
+    editProfile({ providerID: option.providerID, modelID: option.modelID })
+    setModelOpen(false)
+    setModelSearch("")
