+import { expect, test } from "bun:test"
+import { buildEnhancementPrompt, cleanEnhancedText, isEnhanceableText, rebuildPrompt } from "./enhance"
+import type { Prompt } from "./state"
+
+const file = {
+  type: "file" as const,
+  content: "@src/app.ts",
+  start: 6,
+  end: 17,
+  path: "src/app.ts",
+}
+
+const image = {
+  type: "image" as const,
+  id: "image-1",
+  filename: "diagram.png",
+  mime: "image/png",
+  blob: { id: "image-1", url: "" },
+}
+
+test("slash commands and blank drafts are not enhanced", () => {
+  expect(isEnhanceableText("Fix the tests")).toBe(true)
+  expect(isEnhanceableText("  /review  ")).toBe(false)
+  expect(isEnhanceableText("   ")).toBe(false)
+})
+
+test("a fenced or quoted rewrite is unwrapped", () => {
+  expect(cleanEnhancedText("```text\nFix the failing test\n```")).toBe("Fix the failing test")
+  expect(cleanEnhancedText('- "Fix the failing test"')).toBe('- "Fix the failing test"')
+  expect(cleanEnhancedText('"Fix the failing test"')).toBe("Fix the failing test")
+})
+
+test("the enhancement prompt carries the original text and instructions", () => {
+  const prompt = buildEnhancementPrompt("Fix it", "Be terse")
+
+  expect(prompt).toContain("Be terse")
+  expect(prompt).toContain("Fix it")
+})
+
+test("an agent prompt is added before the instructions", () => {
+  const prompt = buildEnhancementPrompt("Fix it", "Be terse", "You are a reviewer.")
+
+  expect(prompt.indexOf("You are a reviewer.")).toBeLessThan(prompt.indexOf("Be terse"))
+  expect(prompt).toContain("Fix it")
+})
+
+test("a rewrite keeps mentions at their new positions and preserves attachments", () => {
+  const prompt: Prompt = [
+    { type: "text", content: "Please fix ", start: 0, end: 11 },
+    file,
+    { type: "text", content: " and check it", start: 17, end: 30 },
+    image,
+  ]
+
+  const rebuilt = rebuildPrompt(prompt, "Fix @src/app.ts so the failing test passes")
+
+  expect(rebuilt.find((part) => part.type === "file")).toMatchObject({ content: "@src/app.ts", start: 4, end: 15 })
+  expect(rebuilt.find((part) => part.type === "text")?.content).toBe("Fix ")
+  expect(rebuilt.find((part) => part.type === "image")).toBe(image)
+})
+
+test("a mention the rewrite dropped is appended", () => {
+  const prompt: Prompt = [{ type: "text", content: "Check ", start: 0, end: 6 }, file]
+
+  const rebuilt = rebuildPrompt(prompt, "Review the change")
+  const text = rebuilt.map((part) => ("content" in part ? part.content : "")).join("")
+
+  expect(text).toBe("Review the change @src/app.ts")
+  expect(rebuilt.find((part) => part.type === "file")).toMatchObject({ start: 18, end: 29 })
+})
